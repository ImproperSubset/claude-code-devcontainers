{
  "name": "Claude Code - ${localWorkspaceFolderBasename}",
  "init": true,
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.1"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "node",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": false
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "none"
    },
    "ghcr.io/devcontainers/features/rust:1": "latest"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=AUDIT_WRITE",
    "--sysctl=net.ipv6.conf.all.disable_ipv6=1",
    "--sysctl=net.ipv6.conf.default.disable_ipv6=1",
    "--sysctl=net.ipv6.conf.lo.disable_ipv6=1",
    "--add-host=host.docker.internal:host-gateway",
    "--env-file=${localWorkspaceFolder}/.env",
    "--device=/dev/dri:/dev/dri"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "openai.chatgpt",
        "sst-dev.opencode",
        "google.gemini-cli-vscode-ide-companion",
        "google.geminicodeassist",
        "github.copilot",
        "github.copilot-chat",
        "kilocode.kilo-code",
        "timonwong.shellcheck",
        "saoudrizwan.claude-dev",
        "scootersoftware.bcompare-vscode",
        "tamasfe.even-better-toml",
        "ms-toolsai.jupyter-keymap",
        "ms-vscode.sublime-keybindings",
        "grapecity.gc-excelviewer",
        "imgildev.vscode-json-flow",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "redhat.vscode-yaml",
        "golang.Go"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-shared,target=/commandhistory,type=volume",
    "source=claude-code-config-shared,target=/home/node/.claude,type=volume",
    "source=codex-config-shared,target=/home/node/.codex,type=volume",
    "source=gemini-config-shared,target=/home/node/.gemini,type=volume",
    "source=opencode-config-shared,target=/home/node/.opencode,type=volume",
    "source=ghub-config-shared,target=/home/node/.config/gh,type=volume",
    "source=npm-global-shared,target=/home/node/.npm-global,type=volume",
    "source=cargo-shared,target=/home/node/.cargo,type=volume",
    "source=bun-shared,target=/home/node/.bun,type=volume",
    "source=local-bin-shared,target=/home/node/.local,type=volume",
    "source=${localEnv:HOME}/.aws,target=/home/node/.aws,type=bind",
    "source=wrangler-config-shared,target=/home/node/.wrangler,type=volume",
    "source=vercel-config-shared,target=/home/node/.vercel,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,readonly",
    "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/run/user/1000/${localEnv:WAYLAND_DISPLAY},type=bind",
    "source=${localEnv:HOME}/.brain,target=/home/node/.brain,type=bind",
    "source=${localEnv:HOME}/git/ralph,target=/home/node/.ralph,type=bind",
    "source=${localEnv:HOME}/git/hh-claude-code-setup,target=/home/node/.claude-setup,type=bind,readonly",
    "source=google-chrome-shared,target=/home/node/.config/google-chrome,type=volume"
  ],
  "containerEnv": {
    "TZ": "${localEnv:TZ:America/New_York}",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "NPM_CONFIG_PREFIX": "/home/node/.npm-global",
    "DEVCONTAINER": "true",
    "WORKSPACE_FOLDER": "/workspaces/${localWorkspaceFolderBasename}",
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "/run/user/1000",
    "CHROMIUM_FLAGS": "--ozone-platform=wayland --no-sandbox",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
    // "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
    // "OTEL_LOG_USER_PROMPTS": "1",
    // "OTEL_METRICS_EXPORTER": "otlp",
    // "OTEL_LOGS_EXPORTER": "otlp",
    // "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    // "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4317",
    // "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=devcontainer,service.name=claude-code"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "appPort": [3000, 5173, 8080, 8888],
  "forwardPorts": [3000, 5173, 8080, 8888],
  "portsAttributes": {
    "3000": {
      "label": "Gemini Server",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Development Server",
      "onAutoForward": "silent"
    },
    "8888": {
      "label": "Jupyter/Lab",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash /usr/local/bin/postCreate.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && bash /usr/local/bin/setup-git-hooks.sh",
  "waitFor": "postCreateCommand"
}
